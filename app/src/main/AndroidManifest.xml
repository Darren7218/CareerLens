<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      100% OFFLINE GUARANTEE:
      Notice there is NO <uses-permission android:name="android.permission.INTERNET" />!
      All data, OCR models, and calculations stay strictly on your device.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Explicitly remove any transitive internet permission from libraries if desired -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <application
        android:name=".CareerLensApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.CareerLens">

        <!-- Pre-bundle ML Kit OCR model metadata -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CareerLens">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share-to-CareerLens Target: Share any Job/Offer Screenshot from Gallery, LinkedIn, JobStreet, or Browser -->
            <intent-filter android:label="Scan Job Screenshot (CareerLens)">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

    </application>

</manifest>
